# LocalVoiceSync Mac 端配置示例
# 复制为 .env 后按需修改（.env 不要提交到 git）

# Syncthing 同步根目录，必须和 Syncthing 里那个文件夹的本地路径一致
LVS_SYNC_ROOT=/Users/you/LocalVoiceSync

# 去重状态库位置
LVS_STATE_DB=/Users/you/.localvoicesync/state.db

# 模型缓存（Whisper 约 1.6GB，fastembed 约 100MB）
LVS_CACHE_DIR=/Users/you/.cache/localvoicesync

# 离线词库目录（THUOCL + custom.txt，随仓库分发，一般不用改）
# LVS_LEXICON_DIR=/path/to/mac_processor/lexicon

# ---------- 转写 ----------
LVS_WHISPER_MODEL=large-v3-turbo
LVS_WHISPER_COMPUTE=int8
LVS_WHISPER_THREADS=8
LVS_WHISPER_WORKERS=2
LVS_WHISPER_BATCH_SIZE=8
# 留空 = 自动检测；固定 zh 可避免中英混说时反复切换
LVS_WHISPER_LANGUAGE=
# beam_size=1（贪心）会丢内容：同一条 48 秒录音只出 33 字，beam=5 出 119 字。
# 别调回 1。
LVS_WHISPER_BEAM_SIZE=5

# ---------- 提示词 ----------
# 必须写成"转写结果"的样子，不能写成指令（指令式会把指令本身当音频内容转写）
LVS_WHISPER_PROMPT=家庭语音备忘。
# 留空 = 自动收集（按成员隔离 + 时间衰减 + 专名挖掘，上限 12 个词）
# off = 关闭；其他值 = 手动词表（逗号分隔），会与自动词**合并**而不是覆盖
LVS_WHISPER_HOTWORDS=

# ---------- 转写后校正 ----------
# 词典纠错：离线词库修同音专名（万圣洁 → 万圣节），确定性、零成本
LVS_LEXICON_CORRECT=1
# LLM 二次校正：修上下文错字（听到棉花糖家 → 停到棉花糖家），每条多几秒
LVS_LLM_CORRECT=1

# ---------- 提炼 ----------
LVS_OLLAMA_URL=http://127.0.0.1:11434
LVS_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
LVS_OLLAMA_TIMEOUT=300
LVS_OLLAMA_NUM_CTX=8192

# ---------- 标签 ----------
# 提炼时把「已有标签」交给模型优先复用，再用确定性规则兜底归并同义标签。
# 关掉它会回到"每条笔记自由造标签"，标签会迅速碎片化，不建议。
LVS_TAG_MERGE=1
# 一篇笔记最多允许新建几个标签；冷启动（词表 <6 个）自动放宽到 3 个。
# 被合并/被限额砍掉的写法会写进 aliases，仍可被搜索到。
LVS_TAG_MAX_NEW=1

# ---------- 向量 ----------
# 必须和手机端 AppConfig.embeddingModelId 一致，否则语义检索会失效
LVS_EMBED_MODEL=BAAI/bge-small-zh-v1.5
LVS_EMBED_DIM=512

# ---------- 调度 ----------
LVS_CONCURRENCY=3
LVS_STABILITY_SECONDS=1.5
LVS_LOG_LEVEL=INFO
LVS_DRY_RUN=0
